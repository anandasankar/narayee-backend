model Testimonial {
  id      String          @id @default(cuid())
  company String?
  rating  Int
  comment String
  type    TestimonialType

  isApproved  Boolean @default(false)
  isPublished Boolean @default(false)
  priority    Int     @default(0)

  submittedById String
  careerId      String?
  approvedById  String?

  submittedBy User    @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  career      Career? @relation(fields: [careerId], references: [id], onDelete: SetNull)
  approvedBy  Admin?  @relation("AdminApprovedTestimonials", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([careerId, type, isApproved, isPublished, priority])
  @@index([submittedById])
  @@index([approvedById])
}

enum TestimonialType {
  CAREER
  GLOBAL
}

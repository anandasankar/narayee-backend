model Notification {
    id               String                @id @default(cuid())
    name             String
    runMode          RunMode               @default(SYSTEM)
    eventCode        String?
    cronExpression   String?
    nextRunningDate  DateTime?
    lastRunningDate  DateTime?
    active           Boolean               @default(true)
    deleted          Boolean               @default(false)
    createdAt        DateTime              @default(now())
    updatedAt        DateTime              @updatedAt
    channels         NotificationChannel[]
    notificationLogs NotificationLog[]

    event EventDefinition? @relation(fields: [eventCode], references: [code])

    @@index([eventCode])
    @@index([nextRunningDate])
}

model NotificationChannel {
    id             String      @id @default(cuid())
    notificationId String
    channel        ChannelType
    enabled        Boolean     @default(true)
    providerCode   String

    contents             NotificationChannelContent[]
    notification         Notification                 @relation(fields: [notificationId], references: [id])
    notificationProvider NotificationProvider         @relation(fields: [providerCode], references: [code])
    notificationLogs     NotificationLog[]

    @@index([notificationId])
    @@index([providerCode])
}

model NotificationChannelContent {
    id          String  @id @default(cuid())
    channelId   String
    subject     String?
    messageText String?
    messageHTML String?

    channel          NotificationChannel @relation(fields: [channelId], references: [id])
    notificationLogs NotificationLog[]

    @@index([channelId])
}

model NotificationProvider {
    id      String      @id @default(cuid())
    code    String      @unique
    channel ChannelType
    active  Boolean     @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    notificationLogs NotificationLog[]
    channels         NotificationChannel[]
}

model NotificationLog {
    id             String                @id @default(cuid())
    senderType     SenderType            @default(SYSTEM)
    senderId       String?
    notificationId String?
    recipientId    String?
    recipientType  RecipientType
    contentId      String?
    subject        String?
    messageBody    String?
    status         MessageStatus         @default(NEW)
    errorMessage   String?
    attempt        Int                   @default(1)
    createdAt      DateTime              @default(now())
    sentAt         DateTime?
    isRead         Boolean               @default(false)
    providerId     String?
    provider       NotificationProvider? @relation(fields: [providerId], references: [id])

    channelType ChannelType?

    logType NotificationLogType @default(DEFAULT)

    notification Notification?               @relation(fields: [notificationId], references: [id])
    content      NotificationChannelContent? @relation(fields: [contentId], references: [id])

    notificationChannel   NotificationChannel? @relation(fields: [notificationChannelId], references: [id])
    notificationChannelId String?

    @@index([recipientId])
    @@index([status])
    @@index([createdAt])
    @@index([notificationId])
    @@index([notificationChannelId])
    @@index([recipientId, status])
}

model EventDefinition {
    id          String    @id @default(cuid())
    name        String
    code        String    @unique
    description String?
    eventType   EventType
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    notifications Notification[]
}

enum EventType {
    SYSTEM
    CUSTOM
}

enum NotificationLogType {
    DEFAULT
    MANUAL
}

enum RecipientType {
    USER
    ADMIN
}

enum RunMode {
    SYSTEM
    PERIODICALLY
    SCHEDULED
    MANUAL
}

enum MessageStatus {
    NEW
    PROGRESS
    ERROR
    OK
}

enum ChannelType {
    EMAIL
    SMS
    WEB_PUSH
    IN_APP
}

enum SenderType {
    ADMIN
    SYSTEM
}

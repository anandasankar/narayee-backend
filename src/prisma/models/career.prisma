model Career {
  id               String      @id @default(cuid())
  title            String      @unique
  shortDescription String
  description      String
  duration         String
  level            CourseLevel[]
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
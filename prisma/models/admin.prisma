model Admin {
  id           String   @id @default(cuid())
  firstName    String
  middleName   String?
  lastName     String
  email        String   @unique
  mobileNumber String?  @unique
  password     String
  active       Boolean  @default(true)
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
